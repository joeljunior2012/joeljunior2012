# ================================
# MODO DE EXECUÇÃO
# ================================
# TEST = modo seguro para validação local
# REAL = modo de produção (ainda sem automação de ordens)
APP_MODE=TEST

# ================================
# LOGGING
# ================================
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_FILE=app.log

# ================================
# ALERTAS POR E-MAIL (GMAIL)
# ================================
# Preencha somente em ambiente local (arquivo .env privado)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_APP_PASSWORD=sua_senha_de_app
ALERT_EMAIL_TO=destinatario@gmail.com

# ================================
# APLICAÇÃO
# ================================
APP_NAME=alert-system
TIMEZONE=UTC
