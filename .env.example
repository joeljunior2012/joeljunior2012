# ================================
# MODO DE EXECUÇÃO
# ================================
# TEST = modo seguro para validação local
# REAL = modo de produção (ainda sem automação de ordens)
APP_MODE=TEST

# ================================
# LOGGING
# ================================
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_FILE=app.log

# ================================
# ALERTAS POR E-MAIL (GMAIL)
# ================================
# Preencha somente em ambiente local (arquivo .env privado)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_APP_PASSWORD=sua_senha_de_app
ALERT_EMAIL_TO=destinatario@gmail.com

# ================================
# APLICAÇÃO
# ================================
APP_NAME=alert-system
TIMEZONE=UTC

# ================================
# CONTROLES OPERACIONAIS
# ================================
# Recursos externos ficam seguros/desligados quando apropriado.
RUN_INBOX=false
RUN_MARKET=true
SEND_DAILY_REPORT=false
IMAP_HOST=imap.gmail.com
MAX_EMAILS_PER_HOUR=10
MAX_SIGNALS_PER_DAY=5
# Valores aceitos: 5, 15, 30 ou 60
ANALYSIS_INTERVAL_MINUTES=15

# ================================
# BACKUP DOS HISTÓRICOS
# ================================
# Para sobreviver à formatação do PC, use uma pasta sincronizada ou externa.
# Exemplo Windows: C:/Users/SeuNome/OneDrive/AlertSystemBackups
BACKUP_ENABLED=false
BACKUP_DIR=backups
BACKUP_RETENTION=30
